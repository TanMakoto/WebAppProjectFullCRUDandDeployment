{
  "info": {
    "_postman_id": "northwind-bms-api-psru",
    "name": "Northwind BMS RESTful API",
    "description": "Collection of RESTful API endpoints for Northwind Business Management System (CPE PSRU Web Application Project)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login (Generate JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.status && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@northwind.co.th\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/index.php?endpoint=auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["index.php"],
              "query": [
                {
                  "key": "endpoint",
                  "value": "auth/login"
                }
              ]
            }
          }
        },
        {
          "name": "Get Current User (Verify Token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/index.php?endpoint=auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["index.php"],
              "query": [
                {
                  "key": "endpoint",
                  "value": "auth/me"
                }
              ]
            }
          }
        }
      ]
    },
    {
